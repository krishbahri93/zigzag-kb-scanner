[Unit]
Description=ZigZag KB scanner web app (uvicorn on 127.0.0.1:8000, fronted by Caddy)
After=network-online.target
Wants=network-online.target

[Service]
User=pinescan
WorkingDirectory=/opt/pinescan
ExecStart=/opt/pinescan/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
