[Unit]
Description=US post-close run: refresh data + forward test (scripts/forward_run.py --market us)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pinescan
WorkingDirectory=/opt/pinescan
ExecStart=/opt/pinescan/scripts/job_wrapper.sh close-us /opt/pinescan/venv/bin/python scripts/forward_run.py --market us
TimeoutStartSec=7200
